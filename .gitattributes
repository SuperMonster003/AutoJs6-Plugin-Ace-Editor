# Packaged text assets keep LF on every checkout. The APK carries the working copy's bytes, and a Windows checkout
# with core.autocrlf=true rewrote 227 of these files to CRLF for a discarded 2.0.0 release build; the bundled font
# catalog's SHA-256 is also compared with the signed remote catalog. Binary files stay as they are (text=auto).
# Keep these rules first: the later rules for specific paths override them, and -text keeps manifest-pinned bytes.
# .python/tests/test_packaged_asset_line_endings.py and verifyAutoJs6TextAssetLineEndings check the result.
app/src/main/assets/** text=auto eol=lf
app/src/main/res/raw/** text=auto eol=lf

# Icon Studio reproducible assets
.icons/assets/** binary
.icons/recipe.json text eol=lf
.python/icon_studio_runtime.py text eol=lf
.python/generate_icon_studio.py text eol=lf
app/src/main/res/raw/keep_plugin_center_icon.xml text eol=lf
app/src/main/res/raw/keep_icon_studio.xml text eol=lf
app/src/main/res/raw/keep_icon_studio_background.xml text eol=lf
app/src/main/res/values*/icon_studio_backgrounds.xml text eol=lf

# Icon Studio reproducible assets
app/src/main/res/mipmap*/ic_icon_studio_application*.xml text eol=lf

# Icon Studio reproducible assets
app/src/main/res/raw/keep_icon_studio_application.xml text eol=lf

# Generated language indices are compared byte-for-byte with deterministic LF output.
app/src/main/assets/editor/ace-builds-*/autojs6/indices/*.js text eol=lf

# Pinned LuaLS runtime assets are verified by size and SHA-256 at runtime (luals/manifest.json).
# Keep the exact upstream bytes on every platform; core.autocrlf must not rewrite them.
app/src/main/assets/luals/** -text
# The Python worker's manifest records byte counts and SHA-256 hashes; checkouts must not convert line endings.
app/src/main/assets/editor/ace-builds-*/autojs6/python/** -text

# Ace assets are compared byte-for-byte with the pinned ace-builds tarball (Roadmap-Ace-1.44.0.md A6-1).
app/src/main/assets/editor/ace-builds-*/src-min-noconflict/** -text -whitespace
app/src/main/assets/editor/ace-builds-*/LICENSE -text

# Byte-exact slices of the legacy customized ace.js; verify-reconstructed.mjs compares their SHA-256.
tools/ace-mobile/reconstructed/original/*.min.js -text -whitespace
