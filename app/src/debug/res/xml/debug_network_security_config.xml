<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: plain HTTP to the loopback, for the font download device test (FontDownloadKitDeviceTest), whose
    mirrors are the HTTP server of tools/device/font_download_check.py reached through adb reverse. Every other host keeps
    the platform default (no cleartext); release builds have no network security configuration of their own.
    zh-CN: 仅 debug 构建: 允许以明文 HTTP 访问回环地址, 供字体下载设备测试 (FontDownloadKitDeviceTest) 使用, 其镜像是经 adb reverse 访问的
    tools/device/font_download_check.py 的 HTTP 服务. 其他主机保持平台默认 (不允许明文); release 构建没有自己的网络安全配置.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
